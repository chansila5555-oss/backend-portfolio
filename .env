# Local backend development only. The root .env.example covers the full stack.

APP_ENV=development
HOST=127.0.0.1
PORT=8080

# Set DB_ENABLED=false to run the API without MySQL. Submissions are then
# rejected with a 500 rather than silently dropped.
DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_app
DB_USER=root
DB_PASSWORD=root

RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=1h
MAX_BODY_BYTES=16384

# Only enable when something you control sets X-Real-IP / X-Forwarded-For.
# Trusting these headers on a directly exposed service lets a single client
# bypass rate limiting by rotating the value.
TRUSTED_PROXY=false
